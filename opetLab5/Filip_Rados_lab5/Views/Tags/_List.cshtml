@model List<Tag>

<div class="lh-card lh-list-card">
    <table class="lh-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Naziv</th>
                <th>Broj postova</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tag in Model)
            {
                <tr>
                    <td class="lh-muted">@tag.Id</td>
                    <td class="lh-strong"><span class="lh-tag">#@tag.Name</span></td>
                    <td>@(tag.Posts?.Count ?? 0)</td>
                    <td class="lh-row-actions">
                        <a asp-action="Details" asp-route-id="@tag.Id">Detalji</a>
                        <a asp-action="Edit" asp-route-id="@tag.Id">Uredi</a>
                        <a asp-action="Delete" asp-route-id="@tag.Id">Obrisi</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div class="lh-empty-state"><i class="fas fa-inbox"></i>Nema tagova za zadani upit.</div>
    }
</div>
