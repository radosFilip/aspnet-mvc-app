@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
    var query = ViewBag.Query as string;
}

<div class="lh-feed-wrapper">
    <div class="lh-section-header">
        <h2 class="lh-section-title">Notifications <span data-result-count>(@Model.Count)</span></h2>
        @if (User.IsInRole("Admin"))
        {
            <a class="lh-button" asp-action="Create"><i class="fas fa-plus"></i> New notification</a>
        }
    </div>
    <div class="lh-toolbar">
        <i class="fas fa-magnifying-glass"></i>
        <input class="lh-search-input" value="@query" placeholder="Search notifications..."
               data-ajax-search data-search-url="@Url.Action("Search", "Notifications")" data-target="#notifications-list" />
    </div>
    <div id="notifications-list" data-list-shell><partial name="_List" model="Model" /></div>
</div>

@section Scripts { <script>LifeHack.initAjaxSearch();</script> }
