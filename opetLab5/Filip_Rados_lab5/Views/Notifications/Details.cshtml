@model Notification
@{ ViewData["Title"] = "Notification #" + Model.Id; }

<div class="lh-feed-wrapper">
    <nav class="lh-breadcrumbs"><a asp-action="Index">Notifications</a><span>/</span><span>Details</span></nav>
    <div class="lh-card">
        <table class="lh-table">
            <tbody>
                <tr><th>ID</th><td>@Model.Id</td></tr>
                <tr><th>Recipient</th><td><a asp-controller="Users" asp-action="Details" asp-route-id="@Model.RecipientId">@Model.Recipient?.Username</a></td></tr>
                <tr><th>Message</th><td>@Model.Message</td></tr>
                <tr><th>Date</th><td>@Model.CreatedAt.ToString("g")</td></tr>
            </tbody>
        </table>
    </div>
</div>
