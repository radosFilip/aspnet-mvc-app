@model List<Comment>
@{
    ViewData["Title"] = "Komentari";
    var query = ViewBag.Query as string;
}

<div class="lh-feed-wrapper">
    <div class="lh-section-header">
        <h2 class="lh-section-title">Komentari <span data-result-count>(@Model.Count)</span></h2>
        <a class="lh-button" asp-action="Create"><i class="fas fa-plus"></i> Novi komentar</a>
    </div>

    <div class="lh-toolbar">
        <i class="fas fa-magnifying-glass"></i>
        <input class="lh-search-input"
               value="@query"
               placeholder="Pretrazi komentare..."
               data-ajax-search
               data-search-url="@Url.Action("Search", "Comments")"
               data-target="#comments-list" />
    </div>

    <div id="comments-list" data-list-shell>
        <partial name="_List" model="Model" />
    </div>
</div>

@section Scripts {
    <script>LifeHack.initAjaxSearch();</script>
}
