@model ReportFormModel
@{
    ViewData["Title"] = "Nova prijava";
}

<div class="lh-feed-wrapper">
    <nav class="lh-breadcrumbs">
        <a asp-action="Index">Prijave</a><span>/</span><span>Nova prijava</span>
    </nav>

    <form asp-action="Create" method="post" class="lh-card lh-form-card">
        <h2 class="lh-form-title">Nova prijava</h2>
        <partial name="_Form" model="Model" />
        <div class="lh-form-actions">
            <a class="lh-button lh-button--ghost" asp-action="Index">Odustani</a>
            <button class="lh-button" type="submit"><i class="fas fa-floppy-disk"></i> Spremi</button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>LifeHack.initForms();</script>
}
