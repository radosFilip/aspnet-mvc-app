@model List<Follow>

<div class="lh-card lh-list-card">
    <table class="lh-table">
        <thead><tr><th>#</th><th>Prati</th><th>Pracen</th><th></th></tr></thead>
        <tbody>
            @foreach (var follow in Model)
            {
                <tr>
                    <td class="lh-muted">@follow.Id</td>
                    <td class="lh-strong"><a asp-controller="Users" asp-action="Details" asp-route-id="@follow.FollowerId">@follow.Follower?.Username</a></td>
                    <td><a asp-controller="Users" asp-action="Details" asp-route-id="@follow.FollowingId">@follow.Following?.Username</a></td>
                    <td class="lh-row-actions">
                        <a asp-action="Details" asp-route-id="@follow.Id">Detalji</a>
                        <a asp-action="Edit" asp-route-id="@follow.Id">Uredi</a>
                        <a asp-action="Delete" asp-route-id="@follow.Id">Obrisi</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="lh-empty-state"><i class="fas fa-inbox"></i>Nema pracenja za zadani upit.</div>
    }
</div>
