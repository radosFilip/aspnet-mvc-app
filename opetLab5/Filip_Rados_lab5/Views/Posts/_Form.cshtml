@model PostFormModel
@{
    var tags = ViewBag.Tags as List<Tag> ?? new();
}

<input asp-for="Id" type="hidden" />
<div asp-validation-summary="ModelOnly" class="lh-validation-summary"></div>

<div class="lh-field">
    <label asp-for="Title" class="lh-label">Title</label>
    <input asp-for="Title" class="lh-input" />
    <span asp-validation-for="Title" class="lh-validation"></span>
</div>

<div class="lh-field">
    <label asp-for="Content" class="lh-label">Content</label>
    <textarea asp-for="Content" class="lh-input lh-textarea"></textarea>
    <span asp-validation-for="Content" class="lh-validation"></span>
</div>

<div class="lh-form-grid">
    <div class="lh-field">
        <label asp-for="Category" class="lh-label">Category</label>
        <select asp-for="Category" asp-items="Html.GetEnumSelectList<PostCategory>()" class="lh-input">
            <option value="">- choose -</option>
        </select>
        <span asp-validation-for="Category" class="lh-validation"></span>
    </div>
    <partial name="~/Views/Shared/_DateTimePicker.cshtml"
             model="@(new DateTimeInputModel { Name = nameof(Model.CreatedAt), Label = "Published at", Value = Model.CreatedAt })" />
</div>

<div class="lh-field">
    <label class="lh-label">Tags</label>
    <div class="lh-check-grid">
        @foreach (var tag in tags)
        {
            <label class="lh-check">
                <input type="checkbox" name="TagIds" value="@tag.Id" checked="@Model.TagIds.Contains(tag.Id)" />
                <span>#@tag.Name</span>
            </label>
        }
    </div>
    <span asp-validation-for="TagIds" class="lh-validation"></span>
</div>
