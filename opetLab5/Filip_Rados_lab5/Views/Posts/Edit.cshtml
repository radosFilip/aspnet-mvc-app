@model PostFormModel
@{
    ViewData["Title"] = "Uredi objavu";
}

<div class="lh-feed-wrapper">
    <nav class="lh-breadcrumbs">
        <a asp-action="Index">Objave</a><span>/</span><span>Uredi</span>
    </nav>

    <form asp-action="Edit" method="post" class="lh-card lh-form-card">
        <h2 class="lh-form-title">Uredi objavu</h2>
        <partial name="_Form" model="Model" />
        <div class="lh-form-actions">
            <a class="lh-button lh-button--ghost" asp-action="Index">Odustani</a>
            <button class="lh-button" type="submit"><i class="fas fa-floppy-disk"></i> Spremi</button>
        </div>
    </form>

    <section class="lh-card">
        <div class="lh-section-header" style="margin-bottom:1rem;">
            <h2 class="lh-section-title"><i class="fas fa-video" style="margin-right:6px;"></i> Videozapisi objave</h2>
        </div>

        <div data-media-upload
             data-upload-url="@Url.Action("UploadVideo", "Posts", new { postId = Model.Id })"
             data-list-url="@Url.Action("GetVideos", "Posts", new { postId = Model.Id })"
             data-target="#postVideoList"
             data-accept="video/mp4,video/webm,video/quicktime,video/x-m4v"
             style="border:2px dashed var(--color-border);border-radius:10px;padding:1.25rem;text-align:center;background:#FAFAFA;cursor:pointer;">
            @Html.AntiForgeryToken()
            <i class="fas fa-cloud-arrow-up" style="font-size:1.8rem;color:var(--color-muted);display:block;margin-bottom:0.5rem;"></i>
            <div style="font-weight:800;">Povucite video ovdje ili kliknite za odabir</div>
            <div style="font-size:0.82rem;color:var(--color-muted);margin-top:0.25rem;">MP4, WebM, MOV ili M4V do 100 MB</div>
            <div data-media-status style="font-size:0.82rem;color:var(--color-muted);margin-top:0.75rem;"></div>
        </div>

        <div id="postVideoList" style="margin-top:1rem;"></div>
    </section>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        LifeHack.initForms();
        LifeHack.initMediaUploads();
    </script>
}
