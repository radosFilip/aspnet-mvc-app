@model Filip_Rados_lab5.Models.Post
@{
    ViewData["Title"] = Model.Title;
    var likeCount = (int)(ViewBag.LikeCount ?? 0);
    var hasLiked = (bool)(ViewBag.HasLiked ?? false);
    var videos = Model.Videos?.OrderByDescending(video => video.CreatedAt).ToList() ?? new();
    var authorImage = Model.Author?.ProfileImages?
        .OrderByDescending(image => image.CreatedAt)
        .FirstOrDefault();
}

<div class="lh-feed-wrapper">
    <nav class="lh-breadcrumbs">
        <a asp-controller="Home" asp-action="Index">Feed</a>
        <span>/</span>
        <a asp-controller="Posts" asp-action="Index">Posts</a>
        <span>/</span>
        <a asp-controller="Posts" asp-action="Index" asp-route-category="@Model.Category.ToString()">@Model.Category</a>
        <span>/</span>
        <span>@Model.Title</span>
    </nav>

    <article class="lh-card">
        <div class="lh-card__meta">
            <a asp-controller="Posts" asp-action="Index" asp-route-category="@Model.Category.ToString()"
               class="lh-card__category" style="text-decoration:none;">@Model.Category</a>
            <span class="lh-card__date">@Model.CreatedAt.ToString("dd. MMMM yyyy.")</span>
        </div>

        <h1 style="font-size:1.85rem;font-weight:900;margin:0.5rem 0 1rem;">@Model.Title</h1>

        @if (videos.Any())
        {
            <div style="display:flex;flex-direction:column;gap:1rem;margin-bottom:1.4rem;">
                @foreach (var video in videos)
                {
                    <video controls preload="metadata" src="@video.FilePath" style="width:100%;max-height:420px;border-radius:10px;background:#111;"></video>
                }
            </div>
        }

        <div class="lh-card__author" style="margin-bottom:1.4rem;color:var(--color-muted);">
            @if (authorImage != null)
            {
                <img src="@authorImage.FilePath"
                     alt="@Model.Author?.Username"
                     style="width:28px;height:28px;border-radius:50%;object-fit:cover;border:1px solid var(--color-border);" />
            }
            else
            {
                <i class="fas fa-user-circle" style="font-size:1.2rem;"></i>
            }
            <a asp-controller="Users" asp-action="Details" asp-route-id="@Model.AuthorId"
               style="color:inherit;text-decoration:none;font-weight:700;">@Model.Author?.Username</a>
        </div>

        <p style="font-size:1rem;line-height:1.8;color:#374151;margin-bottom:1.5rem;">@Model.Content</p>

        @if (Model.Tags != null && Model.Tags.Any())
        {
            <div class="lh-card__tags" style="margin-bottom:1.25rem;">
                @foreach (var tag in Model.Tags)
                {
                    <a asp-controller="Tags" asp-action="Details" asp-route-id="@tag.Id"
                       class="lh-tag" style="text-decoration:none;">#@tag.Name</a>
                }
            </div>
        }

        <div class="lh-card__footer">
            <div class="lh-card__actions">
                <span><i class="fas fa-heart"></i> @likeCount likes</span>
                <span><i class="fas fa-comment"></i> @(Model.Comments?.Count ?? 0) comments</span>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-action="ToggleLike" asp-route-id="@Model.Id" method="post" style="margin:0;">
                    <button class="lh-button @(hasLiked ? "lh-button--ghost" : "")" type="submit">
                        <i class="fas fa-heart"></i> @(hasLiked ? "Unlike" : "Like")
                    </button>
                </form>
            }
            else
            {
                <a class="lh-button lh-button--ghost" asp-controller="Auth" asp-action="Index">Sign in to like</a>
            }
        </div>
    </article>

    <section class="lh-card">
        <div class="lh-section-header" style="margin-bottom:1rem;">
            <h2 class="lh-section-title">
                <i class="fas fa-comment" style="margin-right:6px;"></i>
                Add a comment
            </h2>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-action="AddComment" asp-route-id="@Model.Id" method="post">
                <div class="lh-field">
                    <textarea name="content" class="lh-input lh-textarea" rows="4" maxlength="1200"
                              placeholder="Write your comment..."></textarea>
                </div>
                <div class="lh-form-actions">
                    <button class="lh-button" type="submit"><i class="fas fa-paper-plane"></i> Post comment</button>
                </div>
            </form>
        }
        else
        {
            <a class="lh-button lh-button--ghost" asp-controller="Auth" asp-action="Index">Sign in to comment</a>
        }
    </section>

    @if (Model.Comments != null && Model.Comments.Any())
    {
        <section class="lh-card">
            <div class="lh-section-header" style="margin-bottom:1rem;">
                <h2 class="lh-section-title">
                    <i class="fas fa-comments" style="margin-right:6px;"></i>
                    Comments
                </h2>
            </div>

            <div style="display:flex;flex-direction:column;gap:0.9rem;">
                @foreach (var comment in Model.Comments.OrderBy(c => c.CreatedAt))
                {
                    <div style="border:1px solid var(--color-border);border-radius:10px;padding:0.9rem;background:#FAFAFA;">
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:0.45rem;">
                            <a asp-controller="Users" asp-action="Details" asp-route-id="@comment.AuthorId"
                               style="color:inherit;text-decoration:none;font-weight:800;">
                                <i class="fas fa-user-circle" style="margin-right:4px;color:var(--color-muted);"></i>@comment.Author?.Username
                            </a>
                            <span style="font-size:0.78rem;color:var(--color-muted);">@comment.CreatedAt.ToString("dd. MM. yyyy.")</span>
                        </div>
                        <div style="color:#374151;line-height:1.6;">@comment.Content</div>
                    </div>
                }
            </div>
        </section>
    }
</div>
