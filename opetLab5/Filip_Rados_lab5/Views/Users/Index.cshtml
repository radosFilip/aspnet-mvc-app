@model List<User>
@{
    ViewData["Title"] = "Korisnici";
    var query = ViewBag.Query as string;
}

<div class="lh-feed-wrapper">
    <div class="lh-section-header">
        <h2 class="lh-section-title">Korisnici <span data-result-count>(@Model.Count)</span></h2>
        <a class="lh-button" asp-action="Create"><i class="fas fa-plus"></i> Novi korisnik</a>
    </div>

    <div class="lh-toolbar">
        <i class="fas fa-magnifying-glass"></i>
        <input class="lh-search-input"
               value="@query"
               placeholder="Pretrazi korisnike..."
               data-ajax-search
               data-search-url="@Url.Action("Search", "Users")"
               data-target="#users-list" />
    </div>

    <div id="users-list" data-list-shell>
        <partial name="_List" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
        LifeHack.initAjaxSearch();
    </script>
}
